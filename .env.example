# Copy this file to .env and fill in real values before running TEVNNIS.
# NEVER commit .env — it is git-ignored. .env.example (this file) is safe to commit.

# ---------------------------------------------------------------------------
# Longbridge / LongPort OpenAPI — paper account credentials for v0
# Obtain from: https://open.longportapp.com/account
# ---------------------------------------------------------------------------
# LONGPORT_APP_KEY=
# LONGPORT_APP_SECRET=
# LONGPORT_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Database
# For local dev the docker-compose Postgres matches these defaults.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://tevnnis:tevnnis_dev@localhost:5432/tevnnis
